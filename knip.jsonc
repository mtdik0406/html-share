{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // cdk.json の app から起動するので、knip は入口と見なさない。
  "entry": ["bin/app.ts", "cli/*.ts", "tools/*.ts"],
  "project": [
    "admin-ui/**/*.ts",
    "bin/**/*.ts",
    "cli/**/*.ts",
    "core/**/*.ts",
    "functions/**/*.ts",
    "infra/**/*.ts",
    "tools/**/*.ts",
    "test/**/*.ts"
  ],
  // aws-cdk は `pnpm exec cdk` で使う CLI。package.json の scripts からは呼ばない。
  // esbuild は、NodejsFunction が synth のときに探して使う。コードからは import しない。
  "ignoreDependencies": ["aws-cdk", "esbuild"]
}
