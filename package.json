{
  "name": "html-share",
  "version": "0.1.0",
  "private": true,
  "description": "AI が作った HTML を自分の AWS に置き、署名付き URL で配る",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "keygen": "tsx scripts/keygen.ts",
    "upload": "tsx scripts/upload.ts",
    "sign": "tsx scripts/sign.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^22.20.5",
    "aws-cdk": "^2.1149.0",
    "aws-cdk-lib": "^2.277.0",
    "constructs": "^10.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1173.0",
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/cloudfront-signer": "^3.1172.0"
  }
}
