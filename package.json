{
  "name": "html-share",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "AI が作った HTML を自分の AWS に置き、署名付き URL で配る",
  "type": "module",
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "keygen": "tsx scripts/keygen.ts",
    "keys:store": "tsx scripts/keys-store.ts",
    "sync": "tsx scripts/sync.ts",
    "sign": "tsx scripts/sign.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:repo": "tsx tools/check-repo.ts",
    "lint:unused": "knip",
    "lint:duplicate": "jscpd --exit-code --fail-on-empty --reporters console bin lib scripts tools test",
    "review:scope": "tsx tools/review-scope.ts",
    "review:mutants": "tsx tools/review-mutants.ts",
    "tdd:red": "tsx tools/tdd-red.ts",
    "format": "biome check --write .",
    "test": "tsx --test --experimental-test-coverage --test-coverage-include=\"scripts/**\" --test-coverage-include=\"lib/**\" --test-coverage-include=\"tools/**\" --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95 \"test/**/*.test.ts\"",
    "test:mutation": "stryker run",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run lint:repo && pnpm run lint:unused && pnpm run lint:duplicate && pnpm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@stryker-mutator/api": "^10.1.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/tap-runner": "^10.1.1",
    "@types/node": "^26.6.6",
    "aws-cdk": "^2.1148.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "esbuild": "0.28.2",
    "jscpd": "^5.4.2",
    "knip": "^6.44.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1164.0",
    "@aws-sdk/client-lambda": "^3.1164.0",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/client-ssm": "^3.1164.0",
    "@aws-sdk/cloudfront-signer": "^3.1161.0",
    "parse5": "8.0.1"
  }
}
