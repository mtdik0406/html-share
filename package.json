{
  "name": "html-share",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "AI が作った HTML を自分の AWS に置き、署名付き URL で配る",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "keygen": "tsx scripts/keygen.ts",
    "sync": "tsx scripts/sync.ts",
    "sign": "tsx scripts/sign.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "tsx --test --experimental-test-coverage --test-coverage-include=\"scripts/**\" --test-coverage-include=\"lib/**\" --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95 \"test/**/*.test.ts\"",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^22.20.5",
    "aws-cdk": "^2.1149.0",
    "aws-cdk-lib": "^2.277.0",
    "constructs": "^10.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1173.0",
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/cloudfront-signer": "^3.1172.0",
    "parse5": "8.0.1"
  }
}
