{
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(aws *)",
      "Bash(pnpm exec cdk deploy *)",
      "Bash(pnpm run sync *)"
    ],
    "deny": [
      "Read(/.keys/**)",
      "Bash(pnpm exec cdk destroy *)",
      "Bash(cdk destroy *)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-check.sh",
            "timeout": 300,
            "statusMessage": "pnpm run check"
          }
        ]
      }
    ]
  }
}
