{
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(aws *)",
      "Bash(pnpm exec cdk deploy *)",
      "Bash(pnpm exec cdk destroy *)",
      "Bash(pnpm run sync *)",
      "Edit(/biome.json)",
      "Edit(/tsconfig.json)",
      "Edit(/package.json)",
      "Edit(/pnpm-workspace.yaml)",
      "Edit(/.nvmrc)",
      "Edit(/.githooks/**)",
      "Edit(/.github/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.claude/skills/**)",
      "Edit(/tools/**)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/docs/adr/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-check.sh",
            "timeout": 300,
            "statusMessage": "pnpm run check"
          }
        ]
      }
    ]
  }
}
