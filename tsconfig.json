{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "bin/**/*.ts",
    "cli/**/*.ts",
    "core/**/*.ts",
    "functions/**/*.ts",
    "infra/**/*.ts",
    "test/**/*.ts",
    "tools/**/*.ts"
  ]
}
