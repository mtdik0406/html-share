{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "plugins": ["@stryker-mutator/tap-runner", "./tools/stryker-message-ignorer.js"],
  "testRunner": "tap",
  "tap": {
    "testFiles": ["test/**/*.test.ts"],
    "nodeArgs": ["--test-reporter=tap", "--import", "tsx"]
  },
  "mutate": [
    "admin-ui/**/*.ts",
    "cli/lib/**/*.ts",
    "core/**/*.ts",
    "functions/**/*.ts",
    "infra/**/*.ts",
    "tools/lib/**/*.ts"
  ],
  "reporters": ["clear-text", "progress", "json"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 79
  },
  "ignorers": ["messages"]
}
